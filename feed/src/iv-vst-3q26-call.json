 "guidance": [],
 "segments": [
  {
   "n": 1,
   "t": "prepared",
   "speaker": "Jim Burke (CEO)",
   "asker": "",
   "topic": "사업·재무",
   "point": "선거 결과로 AI 구축 속도에 대한 회사의 장기 기회 판단은 달라지지 않았고, 회사는 데이터센터 성장에 보수적인 가정을 두고 있다고 말했다."
  },
  {
   "n": 2,
   "t": "prepared",
   "speaker": "Jim Burke (CEO)",
   "asker": "",
   "topic": "사업·재무",
   "point": "3분기 조정 EBITDA가 기록을 세웠고, 폭염에 따른 높은 수요 속에서도 화력 fleet 가용률은 약 95%에 근접했다고 설명했다."
  },
  {
   "n": 3,
   "t": "prepared",
   "speaker": "Jim Burke (CEO)",
   "asker": "",
   "topic": "사업·재무",
   "point": "3분기 실적과 Cogentrix 인수를 반영해 2026년 조정 EBITDA와 성장 전 FCF 범위를 좁히고 중간값을 높였다고 밝혔다."
  },
  {
   "n": 4,
   "t": "prepared",
   "speaker": "Jim Burke (CEO)",
   "asker": "",
   "topic": "사업·재무",
   "point": "2027년 EBITDA·성장 전 FCF 가이던스를 새로 제시했으며 Cogentrix와 Meta의 Perry 원전 PPA 기여를 포함한다고 했다."
  },
  {
   "n": 5,
   "t": "prepared",
   "speaker": "Jim Burke (CEO)",
   "asker": "",
   "topic": "사업·재무",
   "point": "Cogentrix를 10월 30일 인수 종결했고 과거 Dynegy·Energy Harbor·Lotus 인수에서 했던 통합 경험을 활용하겠다고 말했다."
  },
  {
   "n": 6,
   "t": "prepared",
   "speaker": "Jim Burke (CEO)",
   "asker": "",
   "topic": "사업·재무",
   "point": "Cogentrix를 더해 전체 발전 포트폴리오가 약 50GW이고 현대식 복합화력은 약 25GW라고 밝혔다."
  },
